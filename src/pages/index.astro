                    <div class="project-terminal-head">
                      <span class="term-dot"></span><span class="term-dot"></span><span class="term-dot"></span>
                      <span class="term-repo">joel-eapen/CampusIn_Backend</span>
                    </div>
                    <ul class="project-terminal-body">
                      <li><span class="term-arrow">›</span> REST APIs + auth</li>
                      <li><span class="term-arrow">›</span> MongoDB + Mongoose</li>
                      <li><span class="term-arrow">›</span> Redis + BullMQ queues</li>
