<script>
  // Portfolio interaction logic
  let isWorkVisible = false;

  function toggleWork() {
    const heroPanel = document.getElementById('hero-panel');
    const workPanel = document.getElementById('work-panel');
    if (!heroPanel || !workPanel) return;

    isWorkVisible = !isWorkVisible;

    if (isWorkVisible) {
      heroPanel.classList.add('shrink');
      workPanel.classList.add('show');
    } else {
      workPanel.classList.remove('show');
      heroPanel.classList.remove('shrink');
    }
  }

  const viewWorkBtn = document.getElementById('viewWorkBtn');
  const backBtn = document.getElementById('backBtn');
  if (viewWorkBtn) viewWorkBtn.addEventListener('click', toggleWork);
  if (backBtn) backBtn.addEventListener('click', toggleWork);

  // ===== View my projects: expand/collapse the card archive =====
  const viewProjectsBtn = document.getElementById('viewProjectsBtn');
  const projectsArchive = document.getElementById('projectsArchive');
  if (viewProjectsBtn && projectsArchive) {
    viewProjectsBtn.addEventListener('click', () => {
      const isHidden = projectsArchive.hasAttribute('hidden');
      if (isHidden) {
        projectsArchive.removeAttribute('hidden');
        // re-trigger stagger animation
        projectsArchive.classList.remove('open');
        void (projectsArchive as HTMLElement).offsetWidth;
        projectsArchive.classList.add('open');
        viewProjectsBtn.setAttribute('aria-expanded', 'true');
        const label = viewProjectsBtn.querySelector('span');
        if (label) label.textContent = 'Hide my projects';
        // scroll the archive into view inside the work panel
        setTimeout(() => {
          projectsArchive.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 60);
      } else {
        projectsArchive.classList.remove('open');
        projectsArchive.setAttribute('hidden', '');
        viewProjectsBtn.setAttribute('aria-expanded', 'false');
        const label = viewProjectsBtn.querySelector('span');
        if (label) label.textContent = 'View my projects';
      }
    });
  }

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isWorkVisible) {
      toggleWork();
    }
  });

  // Smooth stagger animation for work items when panel opens
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      const target = mutation.target as HTMLElement;
      if (target.classList.contains('show')) {
        const items = document.querySelectorAll<HTMLElement>('.work-item');
        items.forEach((item, index) => {
          item.style.opacity = '0';
          item.style.transform = 'translateY(8px)';
          item.style.transition = `opacity 0.4s ease ${0.4 + index * 0.05}s, transform 0.4s ease ${0.4 + index * 0.05}s`;

          requestAnimationFrame(() => {
            item.style.opacity = '1';
            item.style.transform = 'translateY(0)';
          });
        });
      }
    });
  });

  const workPanel = document.getElementById('work-panel');
  if (workPanel) {
    observer.observe(workPanel, {
      attributes: true,
      attributeFilter: ['class'],
    });
  }

  // ===== Live reading data: refresh the "currently reading" spotlight on load =====
  type Book = {
    externalId: string;
    title: string;
    author: string;
    coverImg: string;
    status: 'finished' | 'current_read' | 'want_to_read';
    percentRead: number;
  };

  function httpsCover(url: string): string {
    return url ? url.replace('http://', 'https://') : '';
  }

  function esc(s: string): string {
    const d = document.createElement('div');
    d.textContent = s ?? '';
    return d.innerHTML;
  }

  function renderNowReading(books: Book[]) {
    const el = document.getElementById('nowReading') as HTMLAnchorElement | null;
    if (!el) return;
    const current = books.find((b) => b.status === 'current_read');
    if (!current) {
      el.hidden = true;
      return;
    }
    el.hidden = false;
    el.href = '/library';
    el.classList.remove('skeleton');
    el.removeAttribute('aria-busy');

    const cover = document.getElementById('nowReadingCover');
    if (cover) {
      cover.classList.remove('skeleton-cover');
      cover.innerHTML = current.coverImg
        ? `<img src="${httpsCover(current.coverImg)}" alt="Cover of ${esc(current.title)}" width="40" height="60" />`
        : '';
    }
    const title = document.getElementById('nowReadingTitle');
    if (title) {
      title.className = 'now-reading-title';
      title.textContent = current.title;
    }
    const author = document.getElementById('nowReadingAuthor');
    if (author) {
      author.className = 'now-reading-author';
      author.textContent = current.author;
    }
    const fill = document.getElementById('nowReadingFill');
    if (fill) {
      fill.classList.remove('skeleton-fill');
      fill.style.width = `${current.percentRead ?? 0}%`;
    }
    const pct = document.getElementById('nowReadingPct');
    if (pct) {
      pct.className = 'now-reading-pct';
      pct.textContent = `${current.percentRead ?? 0}% complete`;
    }
  }

  async function loadLiveBooks() {
    try {
      const res = await fetch('/api/books', { headers: { Accept: 'application/json' } });
      if (!res.ok) return; // keep prerendered / skeleton content on failure
      const data = (await res.json()) as { books?: Book[] };
      const books = data.books ?? [];
      renderNowReading(books);
    } catch {
      /* offline / error: keep the prerendered / skeleton content */
    }
  }

  loadLiveBooks();
</script>

<style>
  /* Inline links inside the bio, styled to match the highlighted text. */
  .bio-link {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--social-underline);
    cursor: none;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .bio-link:hover {
    color: var(--accent-hover);
    text-decoration-color: var(--social-underline-hover);
  }

  /* ===== What I've Read ===== */
  .reading-group {
    margin-bottom: 24px;
  }

  .reading-group:last-child {
    margin-bottom: 0;
  }

  .reading-group-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-heading);
    margin-bottom: 14px;
    letter-spacing: 0.01em;
  }

  .book-grid {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .book-card {
    display: flex;
    align-items: center;
    gap: 14px;
    transition: transform 0.2s ease;
  }

  .book-card:hover {
    transform: translateX(2px);
  }

  .book-cover {
    flex-shrink: 0;
    width: 48px;
    height: 72px;
    border-radius: 4px;
    overflow: hidden;
