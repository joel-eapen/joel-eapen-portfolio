---
import Layout from '../components/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import CustomCursor from '../components/CustomCursor.astro';
import { getBooks } from '../lib/readtrack.ts';

// Reading list fetched from the ReadTrack API at build time.
// The homepage only spotlights the currently-reading book below the intro;
// the full library lives on /library.
const books = await getBooks();
const currentBook = books.find((b) => b.status === 'current_read') ?? null;
---

<Layout title="Joel B Eapen" description="Joel B Eapen — Portfolio">
  <!-- Custom Cursor -->
  <CustomCursor />

  <!-- Theme Toggle -->
  <ThemeToggle />

  <div class="layout">
    <!-- LEFT PANEL: Hero / About -->
    <main class="hero-panel" id="hero-panel">
      <div class="hero-content">
        <!-- Profile Image -->
        <div class="profile-image-wrapper">
          <img src="/images/profile.jpg" alt="Joel B Eapen" class="profile-image" />
        </div>

        <!-- Name -->
        <h1 class="name" style="margin-bottom: 8px;">Joel B Eapen</h1>

        <!-- Experience Subtitle -->
        <p style="color: var(--text-bio); font-size: 14.5px; margin-bottom: 24px;">
          B.Tech Student @ <a href="https://www.nitj.ac.in/" target="_blank" rel="noopener noreferrer" style="text-decoration: underline; color: inherit;">NIT Jalandhar</a> |
          AI Engineering Intern @ <a href="https://www.serendipitylabs.in/" target="_blank" rel="noopener noreferrer" style="text-decoration: underline; color: inherit;">Serendipity Labs</a> |
          Building <a href="https://campusin.store" target="_blank" rel="noopener noreferrer" style="text-decoration: underline; color: inherit;">CampusIn</a>
        </p>

        <!-- Bio -->
        <div class="bio">
          <p>
            By day, I'm a <span class="highlight">B.Tech student at NIT Jalandhar</span>, studying Industrial &amp; Production Engineering.
            By night, I turn into a <span class="highlight">builder</span>, writing code, experimenting with ideas, and turning problems into products.
          </p>
          <p>
            I'm focused on <span class="highlight">backend engineering and AI-powered applications</span>, working with technologies like
            <span class="highlight">Node.js</span>, <span class="highlight">Express.js</span>, <span class="highlight">MongoDB</span>, <span class="highlight">PostgreSQL</span>, <span class="highlight">Redis</span>, and <span class="highlight">REST APIs</span>.
          </p>
          <p>
            I've built and shipped projects across <span class="highlight">AI, education, SaaS, and campus technology</span>, including
            <a href="https://keamprep.app" target="_blank" rel="noopener noreferrer" class="highlight bio-link">KEAMPrep</a>, an exam-preparation platform, and <a href="https://campusin.store" target="_blank" rel="noopener noreferrer" class="highlight bio-link">CampusIn</a>, a campus-focused marketplace and food delivery platform.
          </p>
          <p>
            I enjoy going beyond just writing code, thinking about <span class="highlight">architecture, scalability, security, user experience, and how an idea can become a real product</span>.
          </p>
          <p>
            <span class="highlight">Student by day. Builder by night. Always learning, always shipping.</span>
          </p>
        </div>

        <!-- Social Links -->
        <div class="social-links">
          <a href="https://github.com/joel-eapen" class="social-link" target="_blank" rel="noopener noreferrer">GitHub</a>
          <span class="social-separator">·</span>
          <a href="https://x.com/JoelBEapen1" class="social-link" target="_blank" rel="noopener noreferrer">Twitter</a>
          <span class="social-separator">·</span>
          <a href="https://www.linkedin.com/in/joel-b-eapen-86026422b/" class="social-link" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <span class="social-separator">·</span>
          <a href="mailto:eapenjoel4@gmail.com" class="social-link">Email</a>
        </div>

        <!-- View My Work Button -->
        <button class="view-work-btn" id="viewWorkBtn">
          <span>View My Work</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>

        <!-- Currently Reading spotlight (live from ReadTrack); links to the library -->
        <a
          class="now-reading"
          id="nowReading"
          href="/library"
          hidden={!currentBook}
        >
          <div class="now-reading-cover" id="nowReadingCover">
            {currentBook?.coverImg && (
              <img src={currentBook.coverImg.replace('http://', 'https://')} alt={`Cover of ${currentBook.title}`} width="40" height="60" />
            )}
          </div>
          <div class="now-reading-info">
            <span class="now-reading-label">📖 Currently reading</span>
            <span class="now-reading-title" id="nowReadingTitle">{currentBook?.title}</span>
            <span class="now-reading-author" id="nowReadingAuthor">{currentBook?.author}</span>
            <div class="now-reading-bar">
              <div class="now-reading-fill" id="nowReadingFill" style={`width: ${currentBook?.percentRead ?? 0}%`}></div>
            </div>
            <span class="now-reading-pct" id="nowReadingPct">{currentBook?.percentRead ?? 0}% complete</span>
          </div>
        </a>
      </div>
    </main>

    <!-- RIGHT PANEL: Work Section -->
    <aside class="work-panel" id="work-panel">
      <div class="work-content">
        <!-- Back Button -->
        <button class="back-btn" id="backBtn">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span>Back</span>
        </button>

        <!-- Things I've Built -->
        <section class="work-section">
          <h2 class="section-title">THINGS I'VE BUILT</h2>
          <div class="work-items">
            <div class="work-item">
              <a href="https://keamprep.app" class="work-item-name" target="_blank" rel="noopener noreferrer">KEAMPrep</a>
              <span class="work-item-desc"> — An exam preparation platform for KEAM aspirants.</span>
            </div>
            <div class="work-item">
              <a href="https://github.com/joel-eapen/CampusIn_Backend" class="work-item-name" target="_blank" rel="noopener noreferrer">CampusIn Backend</a>
              <span class="work-item-desc"> — Backend infrastructure and APIs for CampusIn.</span>
            </div>
            <div class="work-item">
              <a href="https://github.com/joel-eapen/javascript-amazon-project" class="work-item-name" target="_blank" rel="noopener noreferrer">Amazon Clone</a>
              <span class="work-item-desc"> — A small clone of Amazon built using HTML, CSS and JavaScript (ES6+).</span>
            </div>
          </div>
        </section>

        <!-- Open Source -->
        <section class="work-section">
          <h2 class="section-title">OPEN SOURCE</h2>
          <div class="work-items">
            <div class="work-item">
              <span class="cooking-text">Something is cooking...</span>
            </div>
          </div>
        </section>

        <!-- What I've Read -> dedicated library page -->
        <section class="work-section">
          <h2 class="section-title">WHAT I'VE READ</h2>
          <div class="work-items">
            <div class="work-item">
              <a href="/library" class="work-item-name">View My Library →</a>
              <span class="work-item-desc"> — Everything I've read, am reading, and want to read.</span>
            </div>
          </div>
        </section>

        <hr class="section-divider" />

        <!-- Blogs -->
        <section class="work-section">
          <h2 class="section-title">BLOGS</h2>
          <div class="work-items">
            <div class="work-item">
              <span class="cooking-text">Something is cooking...</span>
            </div>
          </div>
        </section>
      </div>
    </aside>
  </div>
</Layout>

<script>
  // Portfolio interaction logic
  let isWorkVisible = false;

  function toggleWork() {
    const heroPanel = document.getElementById('hero-panel');
    const workPanel = document.getElementById('work-panel');
    if (!heroPanel || !workPanel) return;

    isWorkVisible = !isWorkVisible;

    if (isWorkVisible) {
      heroPanel.classList.add('shrink');
      workPanel.classList.add('show');
    } else {
      workPanel.classList.remove('show');
      heroPanel.classList.remove('shrink');
    }
  }

  const viewWorkBtn = document.getElementById('viewWorkBtn');
  const backBtn = document.getElementById('backBtn');
  if (viewWorkBtn) viewWorkBtn.addEventListener('click', toggleWork);
  if (backBtn) backBtn.addEventListener('click', toggleWork);

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isWorkVisible) {
      toggleWork();
    }
  });

  // Smooth stagger animation for work items when panel opens
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      const target = mutation.target as HTMLElement;
      if (target.classList.contains('show')) {
        const items = document.querySelectorAll<HTMLElement>('.work-item');
        items.forEach((item, index) => {
          item.style.opacity = '0';
          item.style.transform = 'translateY(8px)';
          item.style.transition = `opacity 0.4s ease ${0.4 + index * 0.05}s, transform 0.4s ease ${0.4 + index * 0.05}s`;

          requestAnimationFrame(() => {
            item.style.opacity = '1';
            item.style.transform = 'translateY(0)';
          });
        });
      }
    });
  });

  const workPanel = document.getElementById('work-panel');
  if (workPanel) {
    observer.observe(workPanel, {
      attributes: true,
      attributeFilter: ['class'],
    });
  }

  // ===== Live reading data: refresh the "currently reading" spotlight on load =====
  type Book = {
    externalId: string;
    title: string;
    author: string;
    coverImg: string;
    status: 'finished' | 'current_read' | 'want_to_read';
    percentRead: number;
  };

  function httpsCover(url: string): string {
    return url ? url.replace('http://', 'https://') : '';
  }

  function esc(s: string): string {
    const d = document.createElement('div');
    d.textContent = s ?? '';
    return d.innerHTML;
  }

  function renderNowReading(books: Book[]) {
    const el = document.getElementById('nowReading') as HTMLAnchorElement | null;
    if (!el) return;
    const current = books.find((b) => b.status === 'current_read');
    if (!current) {
      el.hidden = true;
      return;
    }
    el.hidden = false;
    el.href = '/library';

    const cover = document.getElementById('nowReadingCover');
    if (cover) {
      cover.innerHTML = current.coverImg
        ? `<img src="${httpsCover(current.coverImg)}" alt="Cover of ${esc(current.title)}" width="40" height="60" />`
        : '';
    }
    const title = document.getElementById('nowReadingTitle');
    if (title) title.textContent = current.title;
    const author = document.getElementById('nowReadingAuthor');
    if (author) author.textContent = current.author;
    const fill = document.getElementById('nowReadingFill');
    if (fill) fill.style.width = `${current.percentRead ?? 0}%`;
    const pct = document.getElementById('nowReadingPct');
    if (pct) pct.textContent = `${current.percentRead ?? 0}% complete`;
  }

  async function loadLiveBooks() {
    try {
      const res = await fetch('/api/books', { headers: { Accept: 'application/json' } });
      if (!res.ok) return; // keep prerendered content on failure
      const data = (await res.json()) as { books?: Book[] };
      const books = data.books ?? [];
      if (books.length === 0) return;
      renderNowReading(books);
    } catch {
      /* offline / error: keep the prerendered content */
    }
  }

  loadLiveBooks();
</script>

<style>
  /* Inline links inside the bio, styled to match the highlighted text. */
  .bio-link {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--social-underline);
    cursor: none;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .bio-link:hover {
    color: var(--accent-hover);
    text-decoration-color: var(--social-underline-hover);
  }

  /* ===== What I've Read ===== */
  .reading-group {
    margin-bottom: 24px;
  }

  .reading-group:last-child {
    margin-bottom: 0;
  }

  .reading-group-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-heading);
    margin-bottom: 14px;
    letter-spacing: 0.01em;
  }

  .book-grid {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .book-card {
    display: flex;
    align-items: center;
    gap: 14px;
    transition: transform 0.2s ease;
  }

  .book-card:hover {
    transform: translateX(2px);
  }

  .book-cover {
    flex-shrink: 0;
    width: 48px;
    height: 72px;
    border-radius: 4px;
    overflow: hidden;
    background: var(--btn-bg-hover);
    border: 1px solid var(--border-panel);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
  }

  .book-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .book-cover-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: 600;
    color: var(--text-section);
    font-family: 'JetBrains Mono', 'Courier New', monospace;
  }

  .book-meta {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .book-title {
    color: var(--text-highlight);
    font-weight: 500;
    font-size: 14px;
    line-height: 1.4;
  }

  .book-author {
    color: var(--text-desc);
    font-size: 13px;
    font-family: 'JetBrains Mono', 'Courier New', monospace;
  }

  .book-progress {
    color: var(--text-section);
    font-size: 11.5px;
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    margin-top: 1px;
  }

  /* ===== Currently Reading spotlight (below the intro) ===== */
  .now-reading {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 28px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--btn-bg-hover);
    text-decoration: none;
    max-width: 400px;
    transition: border-color 0.2s ease, transform 0.2s ease;
    animation: fadeInUp 0.7s ease 0.6s forwards;
    opacity: 0;
  }

  .now-reading[hidden] {
    display: none;
  }

  .now-reading:hover {
    border-color: var(--border-hover);
    transform: translateY(-1px);
  }

  .now-reading-cover {
    flex-shrink: 0;
    width: 40px;
    height: 60px;
    border-radius: 3px;
    overflow: hidden;
    background: var(--bg);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }

  .now-reading-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .now-reading-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }

  .now-reading-label {
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-section);
    font-family: 'JetBrains Mono', 'Courier New', monospace;
  }

  .now-reading-title {
    color: var(--text-heading);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .now-reading-author {
    color: var(--text-desc);
    font-size: 12.5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .now-reading-bar {
    margin-top: 6px;
    width: 100%;
    height: 4px;
    border-radius: 999px;
    background: var(--border);
    overflow: hidden;
  }

  .now-reading-fill {
    height: 100%;
    background: var(--text-heading);
    border-radius: 999px;
    transition: width 0.6s ease;
  }

  .now-reading-pct {
    margin-top: 4px;
    font-size: 11px;
    color: var(--text-section);
    font-family: 'JetBrains Mono', 'Courier New', monospace;
  }
</style>
