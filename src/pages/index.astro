---
import Layout from '../components/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import CustomCursor from '../components/CustomCursor.astro';
---

<Layout title="Joel B Eapen" description="Joel B Eapen — Portfolio">
  <!-- Custom Cursor -->
  <CustomCursor />

  <!-- Theme Toggle -->
  <ThemeToggle />

  <div class="layout">
    <!-- LEFT PANEL: Hero / About -->
    <main class="hero-panel" id="hero-panel">
      <div class="hero-content">
        <!-- Profile Image -->
        <div class="profile-image-wrapper">
          <img src="/images/profile.jpg" alt="Joel B Eapen" class="profile-image" />
        </div>

        <!-- Name -->
        <h1 class="name" style="margin-bottom: 8px;">Joel B Eapen</h1>

        <!-- Experience Subtitle -->
        <p style="color: var(--text-bio); font-size: 14.5px; margin-bottom: 24px;">
          B.Tech Student @ <a href="https://www.nitj.ac.in/" target="_blank" rel="noopener noreferrer" style="text-decoration: underline; color: inherit;">NIT Jalandhar</a> |
          AI Engineering Intern @ <a href="https://www.serendipitylabs.in/" target="_blank" rel="noopener noreferrer" style="text-decoration: underline; color: inherit;">Serendipity Labs</a> |
          Building <a href="https://campusin.store" target="_blank" rel="noopener noreferrer" style="text-decoration: underline; color: inherit;">CampusIn</a>
        </p>

        <!-- Bio -->
        <div class="bio">
          <p>
            By day, I'm a <span class="highlight">B.Tech student at NIT Jalandhar</span>, studying Industrial &amp; Production Engineering.
            By night, I turn into a <span class="highlight">builder</span>, writing code, experimenting with ideas, and turning problems into products.
          </p>
          <p>
            I'm focused on <span class="highlight">backend engineering and AI-powered applications</span>, working with technologies like
            <span class="highlight">Node.js</span>, <span class="highlight">Express.js</span>, <span class="highlight">MongoDB</span>, <span class="highlight">PostgreSQL</span>, <span class="highlight">Redis</span>, and <span class="highlight">REST APIs</span>.
          </p>
          <p>
            I've built and shipped projects across <span class="highlight">AI, education, SaaS, and campus technology</span>, including
            <a href="https://keamprep.app" target="_blank" rel="noopener noreferrer" class="highlight bio-link">KEAMPrep</a>, an exam-preparation platform, and <a href="https://campusin.store" target="_blank" rel="noopener noreferrer" class="highlight bio-link">CampusIn</a>, a campus-focused marketplace and food delivery platform.
          </p>
          <p>
            I enjoy going beyond just writing code, thinking about <span class="highlight">architecture, scalability, security, user experience, and how an idea can become a real product</span>.
          </p>
          <p>
            <span class="highlight">Student by day. Builder by night. Always learning, always shipping.</span>
          </p>
        </div>

        <!-- Social Links -->
        <div class="social-links">
          <a href="https://github.com/joel-eapen" class="social-link" target="_blank" rel="noopener noreferrer">GitHub</a>
          <span class="social-separator">·</span>
          <a href="https://x.com/JoelBEapen1" class="social-link" target="_blank" rel="noopener noreferrer">Twitter</a>
          <span class="social-separator">·</span>
          <a href="https://www.linkedin.com/in/joel-b-eapen-86026422b/" class="social-link" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <span class="social-separator">·</span>
          <a href="mailto:eapenjoel4@gmail.com" class="social-link">Email</a>
        </div>

        <!-- View My Work Button -->
        <button class="view-work-btn" id="viewWorkBtn">
          <span>View My Work</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </main>

    <!-- RIGHT PANEL: Work Section -->
    <aside class="work-panel" id="work-panel">
      <div class="work-content">
        <!-- Back Button -->
        <button class="back-btn" id="backBtn">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span>Back</span>
        </button>

        <!-- Things I've Built -->
        <section class="work-section">
          <h2 class="section-title">THINGS I'VE BUILT</h2>
          <div class="work-items">
            <div class="work-item">
              <a href="https://keamprep.app" class="work-item-name" target="_blank" rel="noopener noreferrer">KEAMPrep</a>
              <span class="work-item-desc"> — An exam preparation platform for KEAM aspirants.</span>
            </div>
            <div class="work-item">
              <a href="https://github.com/joel-eapen/CampusIn_Backend" class="work-item-name" target="_blank" rel="noopener noreferrer">CampusIn Backend</a>
              <span class="work-item-desc"> — Backend infrastructure and APIs for CampusIn.</span>
            </div>
            <div class="work-item">
              <a href="https://github.com/joel-eapen/javascript-amazon-project" class="work-item-name" target="_blank" rel="noopener noreferrer">Amazon Clone</a>
              <span class="work-item-desc"> — A small clone of Amazon built using HTML, CSS and JavaScript (ES6+).</span>
            </div>
          </div>
        </section>

        <!-- Open Source -->
        <section class="work-section">
          <h2 class="section-title">OPEN SOURCE</h2>
          <div class="work-items">
            <div class="work-item">
              <span class="cooking-text">Something is cooking...</span>
            </div>
          </div>
        </section>

        <!-- What I've Read -->
        <section class="work-section">
          <h2 class="section-title">WHAT I'VE READ</h2>

          <div class="reading-group">
            <h3 class="reading-group-title">Fiction &amp; Series</h3>
            <div class="work-items reading-list">
              <div class="book-item"><span class="book-title">Harry Potter (Books 1–5, 7)</span><span class="book-author">J.K. Rowling</span></div>
              <div class="book-item"><span class="book-title">Percy Jackson &amp; the Olympians (Books 1–3)</span><span class="book-author">Rick Riordan</span></div>
              <div class="book-item"><span class="book-title">The Alchemist</span><span class="book-author">Paulo Coelho</span></div>
              <div class="book-item"><span class="book-title">1984</span><span class="book-author">George Orwell</span></div>
              <div class="book-item"><span class="book-title">A Man Called Ove</span><span class="book-author">Fredrik Backman</span></div>
              <div class="book-item"><span class="book-title">Ghachar Ghochar</span><span class="book-author">Vivek Shanbhag</span></div>
              <div class="book-item"><span class="book-title">The Blue Umbrella</span><span class="book-author">Ruskin Bond</span></div>
              <div class="book-item"><span class="book-title">The Night Train at Deoli</span><span class="book-author">Ruskin Bond</span></div>
              <div class="book-item"><span class="book-title">Dollar Bahu</span><span class="book-author">Sudha Murty</span></div>
              <div class="book-item"><span class="book-title">House of Cards</span><span class="book-author">Sudha Murty</span></div>
              <div class="book-item"><span class="book-title">400 Days</span><span class="book-author">Chetan Bhagat</span></div>
            </div>
          </div>

          <div class="reading-group">
            <h3 class="reading-group-title">Thriller &amp; Mystery</h3>
            <div class="work-items reading-list">
              <div class="book-item"><span class="book-title">Murder on the Orient Express</span><span class="book-author">Agatha Christie</span></div>
              <div class="book-item"><span class="book-title">And Then There Were None</span><span class="book-author">Agatha Christie</span></div>
              <div class="book-item"><span class="book-title">The Murder of Roger Ackroyd</span><span class="book-author">Agatha Christie</span></div>
              <div class="book-item"><span class="book-title">The Da Vinci Code</span><span class="book-author">Dan Brown</span></div>
              <div class="book-item"><span class="book-title">Angels &amp; Demons</span><span class="book-author">Dan Brown</span></div>
              <div class="book-item"><span class="book-title">The Lost Symbol</span><span class="book-author">Dan Brown</span></div>
              <div class="book-item"><span class="book-title">The Silent Patient</span><span class="book-author">Alex Michaelides</span></div>
              <div class="book-item"><span class="book-title">The Couple Next Door</span><span class="book-author">Shari Lapena</span></div>
              <div class="book-item"><span class="book-title">One of Us Is Lying</span><span class="book-author">Karen M. McManus</span></div>
              <div class="book-item"><span class="book-title">Headhunters</span><span class="book-author">Jo Nesbø</span></div>
              <div class="book-item"><span class="book-title">The October List</span><span class="book-author">Jeffery Deaver</span></div>
              <div class="book-item"><span class="book-title">The Grownup</span><span class="book-author">Gillian Flynn</span></div>
              <div class="book-item"><span class="book-title">The New Year's Party</span><span class="book-author">Daniel Hurst</span></div>
              <div class="book-item"><span class="book-title">The Little Men</span><span class="book-author">Megan Abbott</span></div>
            </div>
          </div>

          <div class="reading-group">
            <h3 class="reading-group-title">Non-fiction &amp; Memoir</h3>
            <div class="work-items reading-list">
              <div class="book-item"><span class="book-title">Shoe Dog</span><span class="book-author">Phil Knight</span></div>
              <div class="book-item"><span class="book-title">Open: An Autobiography</span><span class="book-author">Andre Agassi</span></div>
              <div class="book-item"><span class="book-title">That Will Never Work</span><span class="book-author">Marc Randolph</span></div>
              <div class="book-item"><span class="book-title">Deep Work</span><span class="book-author">Cal Newport</span></div>
              <div class="book-item"><span class="book-title">Elon Musk</span><span class="book-author">Ashlee Vance</span></div>
              <div class="book-item"><span class="book-title">Do Epic Shit</span><span class="book-author">Ankur Warikoo</span></div>
              <div class="book-item"><span class="book-title">I Am Malala</span><span class="book-author">Malala Yousafzai</span></div>
              <div class="book-item"><span class="book-title">Letters from a Father to His Daughter</span><span class="book-author">Jawaharlal Nehru</span></div>
            </div>
          </div>
        </section>

        <hr class="section-divider" />

        <!-- Blogs -->
        <section class="work-section">
          <h2 class="section-title">BLOGS</h2>
          <div class="work-items">
            <div class="work-item">
              <span class="cooking-text">Something is cooking...</span>
            </div>
          </div>
        </section>
      </div>
    </aside>
  </div>
</Layout>

<script>
  // Portfolio interaction logic
  let isWorkVisible = false;

  function toggleWork() {
    const heroPanel = document.getElementById('hero-panel');
    const workPanel = document.getElementById('work-panel');
    if (!heroPanel || !workPanel) return;

    isWorkVisible = !isWorkVisible;

    if (isWorkVisible) {
      heroPanel.classList.add('shrink');
      workPanel.classList.add('show');
    } else {
      workPanel.classList.remove('show');
      heroPanel.classList.remove('shrink');
    }
  }

  const viewWorkBtn = document.getElementById('viewWorkBtn');
  const backBtn = document.getElementById('backBtn');
  if (viewWorkBtn) viewWorkBtn.addEventListener('click', toggleWork);
  if (backBtn) backBtn.addEventListener('click', toggleWork);

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isWorkVisible) {
      toggleWork();
    }
  });

  // Smooth stagger animation for work items when panel opens
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      const target = mutation.target as HTMLElement;
      if (target.classList.contains('show')) {
        const items = document.querySelectorAll<HTMLElement>('.work-item');
        items.forEach((item, index) => {
          item.style.opacity = '0';
          item.style.transform = 'translateY(8px)';
          item.style.transition = `opacity 0.4s ease ${0.4 + index * 0.05}s, transform 0.4s ease ${0.4 + index * 0.05}s`;

          requestAnimationFrame(() => {
            item.style.opacity = '1';
            item.style.transform = 'translateY(0)';
          });
        });
      }
    });
  });

  const workPanel = document.getElementById('work-panel');
  if (workPanel) {
    observer.observe(workPanel, {
      attributes: true,
      attributeFilter: ['class'],
    });
  }
</script>

<style>
  /* Inline links inside the bio, styled to match the highlighted text. */
  .bio-link {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--social-underline);
    cursor: none;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .bio-link:hover {
    color: var(--accent-hover);
    text-decoration-color: var(--social-underline-hover);
  }

  /* ===== What I've Read ===== */
  .reading-group {
    margin-bottom: 22px;
  }

  .reading-group:last-child {
    margin-bottom: 0;
  }

  .reading-group-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-heading);
    margin-bottom: 12px;
    letter-spacing: 0.01em;
  }

  .reading-list {
    gap: 8px;
  }

  .book-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    font-size: 14px;
    line-height: 1.5;
    transition: transform 0.2s ease;
  }

  .book-item:hover {
    transform: translateX(2px);
  }

  .book-title {
    color: var(--text-highlight);
    font-weight: 500;
  }

  .book-author {
    color: var(--text-desc);
    font-size: 13px;
    white-space: nowrap;
    flex-shrink: 0;
    font-family: 'JetBrains Mono', 'Courier New', monospace;
  }

  @media (max-width: 480px) {
    .book-item {
      flex-direction: column;
      gap: 2px;
    }
    .book-author {
      white-space: normal;
    }
  }
</style>
